# Dropbox app credentials (App Console -> your app)
TDBX_AKEY=
TDBX_ASEC=
# Written for you (never printed) by: docker compose run --rm -it -v ./.env:/env truedbx auth --env-file /env
TDBX_TOKN=

# Host folder mounted read-only at /data in the container
TDBX_HOST_PATH=/mnt/pool/dataset
# What to upload (path inside container) and where to (Dropbox folder); --source/--target override
TDBX_SOURCE=/data
TDBX_TARGET=/Backups/truenas
TDBX_PARALLEL=5

# Published image (ghcr.io/<github-owner>/<repo>:latest)
TDBX_IMAGE=ghcr.io/shunte88/truedbx:latest
